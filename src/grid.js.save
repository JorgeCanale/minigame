
function MapGridInit(width, heigth) {
    let h;
    let w;
    if(heigth !== undefined && heigth > 0 ) {
        h = heigth;
    }else{ 
        h = 9;
    }
    if(width !== undefined && width > 0 ) {
        w = width;
    }else{ 
        w = 9;
    }
    for (let i = 0; i < h; i++) {
        let gridLine = [];
        for (let j = 0; j < w; j++) {
            if (i === 0 || i === h - 1) {
                gridLine.push("#");
            } else if (j === 0 || j === w - 1) {
                gridLine.push("#");
            } else {
                gridLine.push("-");
            };
        };
        grid.push(gridLine);
    };
    setRandomGoal();
};


function clearGrid() {
    grid = [];
};

module.exports = { MapGridInit, clearGrid};

